{
  "name": "rs6809-debug",
  "displayName": "rs6809 ICE",
  "description": "Debug programs in the rs6809 emulator through its ICE (Debug Adapter Protocol over TCP): 6809 / NitrOS-9, and the 68000 with CP/M-68K or FUZIX.",
  "version": "0.2.0",
  "publisher": "rs6809",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Debuggers"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onDebugResolve:rs6809"
  ],
  "contributes": {
    "breakpoints": [
      {
        "language": "c"
      },
      {
        "language": "asm"
      },
      {
        "language": "m68k"
      },
      {
        "language": "plaintext"
      }
    ],
    "debuggers": [
      {
        "type": "rs6809",
        "label": "rs6809 ICE",
        "configurationAttributes": {
          "attach": {
            "properties": {
              "host": {
                "type": "string",
                "default": "127.0.0.1",
                "description": "Host running rs6809 --dap"
              },
              "port": {
                "type": "number",
                "default": 6810,
                "description": "DAP port (rs6809 --dap 127.0.0.1:6810)"
              },
              "symbols": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Symbols to load, on the emulator host: LWASM .lst, RMA .lst + .map + .m, LWLINK/c.link .map, GNU as listings (.lst with the nm .map beside it), nm output, CP/M-68K NM68 maps, or directories of them."
              },
              "sourceDirs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Directories searched for the source files named in the listings"
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false,
                "description": "Pause the emulator when attaching"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "rs6809",
            "request": "attach",
            "name": "rs6809: attach",
            "port": 6810,
            "symbols": [
              "${workspaceFolder}/artifacts/cdebug/hello"
            ],
            "sourceDirs": [
              "${workspaceFolder}/examples"
            ]
          }
        ],
        "configurationSnippets": [
          {
            "label": "rs6809: attach to the ICE",
            "description": "Any machine started with --dap",
            "body": {
              "type": "rs6809",
              "request": "attach",
              "name": "rs6809: attach",
              "port": 6810,
              "symbols": [],
              "sourceDirs": []
            }
          },
          {
            "label": "rs6809: CP/M-68K (BIOS source, CCP/BDOS names)",
            "description": "sh examples/cpm68k.sh --dap",
            "body": {
              "type": "rs6809",
              "request": "attach",
              "name": "rs6809: CP/M-68K",
              "port": 6810,
              "symbols": [
                "^\"\\${workspaceFolder}/examples/cpm68k/bios.lst\"",
                "^\"\\${workspaceFolder}/artifacts/cpm68k/dist/DISK8/CPM15000.MAP\""
              ],
              "sourceDirs": [
                "^\"\\${workspaceFolder}/examples/cpm68k\""
              ]
            }
          },
          {
            "label": "rs6809: FUZIX/68000 (kernel symbols)",
            "description": "sh examples/fuzix68k.sh --dap",
            "body": {
              "type": "rs6809",
              "request": "attach",
              "name": "rs6809: FUZIX",
              "port": 6810,
              "symbols": [
                "^\"\\${workspaceFolder}/artifacts/fuzix68k/fuzix.sym\""
              ],
              "sourceDirs": []
            }
          }
        ]
      }
    ]
  }
}
