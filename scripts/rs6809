#!/bin/sh
# Run the emulator: the prebuilt bin/rs6809 when setup.sh chose it (no Rust,
# or one older than the edition needs), otherwise the cargo build.
here=$(dirname "$0")/..
if [ -x "$here/bin/rs6809" ]; then
	exec "$here/bin/rs6809" "$@"
fi
if command -v cargo >/dev/null 2>&1; then
	exec cargo run --release --quiet --manifest-path "$here/Cargo.toml" -- "$@"
fi
echo "rs6809: run ./setup.sh first (or install Rust: https://rustup.rs)" >&2
exit 1
