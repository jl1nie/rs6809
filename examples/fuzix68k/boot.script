# Answers for FUZIX booting on Tiny68K (examples/fuzix68k.sh).
bootdev:	hda1
# fsck after a stop without halt (--persist): check and repair. Lines
# starting with ? are answered whenever the prompt shows.
?Continue? 	y
?Fix? 	y
?Zap? 	y
?Rebuild free list? 	y
Enter new date:	
Enter new time:	
login:	root
