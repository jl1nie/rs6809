68K GAS  bios.s 			page 1


   1               	| CP/M-68K 1.3 BIOS for the Tiny68K-compatible machine of rs6809.
   2               	|
   3               	| CPM15000.SR (the system without a BIOS, $15000-$1ACC1) calls _init at
   4               	| $1B000 on a cold start; BDOS calls the other functions through TRAP #3
   5               	| with the function number in D0.W and parameters in D1/D2.
   6               	|
   7               	|   console   MC68681 DUART channel A ($FFF000, odd addresses), polled
   8               	|   list/aux  DUART channel B
   9               	|   disk A:   IDE (CompactFlash) at $FFE000, LBA, 512-byte sectors
  10               	|
  11               	| Disk A: is 8 MiB: 2048 tracks of 32 logical 128-byte sectors (8 IDE
  12               	| sectors), one reserved track, 4 KiB blocks and 512 directory entries.
  13               	| BDOS works in 128-byte sectors; the BIOS keeps one 512-byte IDE sector
  14               	| in a buffer (read-modify-write, written through on every write).
  15               	|
  16               	| Build: python3 scripts/build-cpm68k-bios.py (GNU as for m68k).
  17               	
  18               		.equ	CCP, 0x150bc		| _ccp in CPM15000.MAP (warm boot)
  19               		.equ	TRAP3, 0x8c		| TRAP #3 vector
  20               		.equ	TPA_BASE, 0x20000	| TPA above the BIOS ...
  21               		.equ	TPA_END, 0xfe0000	| ... to near the top of RAM
  22               	
  23               		.equ	DUART, 0xfff000
  24               		.equ	MRA, 0x01
  25               		.equ	SRA, 0x03
  26               		.equ	CSRA, 0x03
  27               		.equ	CRA, 0x05
  28               		.equ	RHRA, 0x07
  29               		.equ	THRA, 0x07
  30               		.equ	ACR, 0x09
  31               		.equ	IMR, 0x0b
  32               		.equ	SRB, 0x13
  33               		.equ	CRB, 0x15
  34               		.equ	RHRB, 0x17
  35               		.equ	THRB, 0x17
  36               		.equ	RXRDY, 0		| status bits
  37               		.equ	TXRDY, 2
  38               	
  39               		.equ	IDE, 0xffe000
  40               		.equ	IDE_DATA, 0x00
  41               		.equ	IDE_COUNT, 0x05
  42               		.equ	IDE_LBA0, 0x07
  43               		.equ	IDE_LBA1, 0x09
  44               		.equ	IDE_LBA2, 0x0b
  45               		.equ	IDE_HEAD, 0x0d
  46               		.equ	IDE_CMD, 0x0f
  47               		.equ	IDE_STATUS, 0x0f
  48               		.equ	BSY, 7
  49               		.equ	DRQ, 3
  50               		.equ	ERR, 0
  51               	
  52               		.equ	SPT, 32			| logical sectors per track
  53               		.equ	NFUNCS, 23
  54               	
  55               		.text
  56               		.globl	_init
