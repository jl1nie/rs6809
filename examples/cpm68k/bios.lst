68K GAS  bios.s 			page 1


   1               	| CP/M-68K 1.3 BIOS for the Tiny68K-compatible machine of rs6809.
   2               	|
   3               	| CPM15000.SR (the system without a BIOS, $15000-$1ACC1) calls _init at
   4               	| $1B000 on a cold start; BDOS calls the other functions through TRAP #3
   5               	| with the function number in D0.W and parameters in D1/D2.
   6               	|
   7               	|   console   MC68681 DUART channel A ($FFF000, odd addresses); input is
   8               	|             waited for with STOP and the receive interrupt (level 2)
   9               	|   list/aux  DUART channel B
  10               	|   disk A:   IDE (CompactFlash) at $FFE000, LBA, 512-byte sectors
  11               	|
  12               	| Disk A: is 8 MiB: 2048 tracks of 32 logical 128-byte sectors (8 IDE
  13               	| sectors), one reserved track, 4 KiB blocks and 512 directory entries.
  14               	| BDOS works in 128-byte sectors; the BIOS keeps one 512-byte IDE sector
  15               	| in a buffer (read-modify-write, written through on every write).
  16               	|
  17               	| Build: python3 scripts/build-cpm68k-bios.py (GNU as for m68k).
  18               	
  19               		.equ	CCP, 0x150bc		| _ccp in CPM15000.MAP (warm boot)
  20               		.equ	TRAP3, 0x8c		| TRAP #3 vector
  21               		.equ	TPA_BASE, 0x20000	| TPA above the BIOS ...
  22               		.equ	TPA_END, 0xfe0000	| ... to near the top of RAM
  23               	
  24               		.equ	DUART, 0xfff000
  25               		.equ	MRA, 0x01
  26               		.equ	SRA, 0x03
  27               		.equ	CSRA, 0x03
  28               		.equ	CRA, 0x05
  29               		.equ	RHRA, 0x07
  30               		.equ	THRA, 0x07
  31               		.equ	ACR, 0x09
  32               		.equ	IMR, 0x0b
  33               		.equ	IVR, 0x19
  34               		.equ	RXVEC, 64		| vector number of the DUART interrupt
  35               		.equ	RXINT_A, 0x02		| IMR: channel A receiver ready
  36               		.equ	SRB, 0x13
  37               		.equ	CRB, 0x15
  38               		.equ	RHRB, 0x17
  39               		.equ	THRB, 0x17
  40               		.equ	RXRDY, 0		| status bits
  41               		.equ	TXRDY, 2
  42               	
  43               		.equ	IDE, 0xffe000
  44               		.equ	IDE_DATA, 0x00
  45               		.equ	IDE_COUNT, 0x05
  46               		.equ	IDE_LBA0, 0x07
  47               		.equ	IDE_LBA1, 0x09
  48               		.equ	IDE_LBA2, 0x0b
  49               		.equ	IDE_HEAD, 0x0d
  50               		.equ	IDE_CMD, 0x0f
  51               		.equ	IDE_STATUS, 0x0f
  52               		.equ	BSY, 7
  53               		.equ	DRQ, 3
  54               		.equ	ERR, 0
  55               	
  56               		.equ	SPT, 32			| logical sectors per track
  57               		.equ	NFUNCS, 23
