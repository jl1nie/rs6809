68K GAS  bios.s 			page 1


   1               	| CP/M-68K 1.3 BIOS for the Tiny68K-compatible machine of rs6809.
   2               	|
   3               	| CPM15000.SR (the system without a BIOS, $15000-$1ACC1) calls _init at
   4               	| $1B000 on a cold start; BDOS calls the other functions through TRAP #3
   5               	| with the function number in D0.W and parameters in D1/D2.
   6               	|
   7               	|   console   MC68681 DUART channel A ($FFF000, odd addresses); input is
   8               	|             waited for with STOP and the receive interrupt (level 2)
   9               	|   list/aux  DUART channel B
  10               	|   disk A:   IDE (CompactFlash) at $FFE000, LBA, 512-byte sectors
  11               	|
  12               	| Disk A: is 8 MiB: 2048 tracks of 32 logical 128-byte sectors (8 IDE
  13               	| sectors), one reserved track, 4 KiB blocks and 512 directory entries.
  14               	| BDOS works in 128-byte sectors; the BIOS keeps one 512-byte IDE sector
  15               	| in a buffer (read-modify-write, written through on every write).
  16               	|
  17               	| Build: python3 scripts/build-cpm68k-bios.py (GNU as for m68k); with --tn20k
  18               	| the TPA ends at $800000 for the 8 MiB machine of rs6809-fpga
  19               	| (bios-tn20k.sr).
  20               	
  21               		.equ	CCP, 0x150bc		| _ccp in CPM15000.MAP (warm boot)
  22               		.equ	TRAP3, 0x8c		| TRAP #3 vector
  23               		.equ	TPA_BASE, 0x20000	| TPA above the BIOS ...
  24               		.ifdef	TN20K
  25               		.equ	TPA_END, 0x800000	| ... to the top of the 8 MiB (rs6809-fpga)
  26               		.else
  27               		.equ	TPA_END, 0xfe0000	| ... to near the top of RAM
  28               		.endif
  29               	
  30               		.equ	DUART, 0xfff000
  31               		.equ	MRA, 0x01
  32               		.equ	SRA, 0x03
  33               		.equ	CSRA, 0x03
  34               		.equ	CRA, 0x05
  35               		.equ	RHRA, 0x07
  36               		.equ	THRA, 0x07
  37               		.equ	ACR, 0x09
  38               		.equ	IMR, 0x0b
  39               		.equ	IVR, 0x19
  40               		.equ	RXVEC, 64		| vector number of the DUART interrupt
  41               		.equ	RXINT_A, 0x02		| IMR: channel A receiver ready
  42               		.equ	SRB, 0x13
  43               		.equ	CRB, 0x15
  44               		.equ	RHRB, 0x17
  45               		.equ	THRB, 0x17
  46               		.equ	RXRDY, 0		| status bits
  47               		.equ	TXRDY, 2
  48               	
  49               		.equ	IDE, 0xffe000
  50               		.equ	IDE_DATA, 0x00
  51               		.equ	IDE_COUNT, 0x05
  52               		.equ	IDE_LBA0, 0x07
  53               		.equ	IDE_LBA1, 0x09
  54               		.equ	IDE_LBA2, 0x0b
  55               		.equ	IDE_HEAD, 0x0d
  56               		.equ	IDE_CMD, 0x0f
  57               		.equ	IDE_STATUS, 0x0f
